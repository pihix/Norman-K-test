{
  "family": "normank-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::619071311778:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::619071311778:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "REPLACED_BY_GA",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "dev" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/normank-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "dev"
        }
      }
    }
  ]
}
